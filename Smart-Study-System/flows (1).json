    {
        "id": "135088413ae1d471",
        "type": "function",
        "z": "4c59e0a7bb62b38b",
        "name": "function 1",
        "func": "let currentUnit = flow.get(\"currentUnit\") || \"No Unit Selected\";\nlet unitTimes = flow.get(\"unitTimes\") || {};\n\nif (!unitTimes[currentUnit]) {\n    unitTimes[currentUnit] = 0;\n}\n\nif (flow.get(\"focusStatus\") === \"Focused\") {\n    unitTimes[currentUnit] += 1;\n}\n\nflow.set(\"unitTimes\", unitTimes);\n\nlet totalSeconds = unitTimes[currentUnit];\nlet minutes = Math.floor(totalSeconds / 60);\nlet seconds = totalSeconds % 60;\n\nmsg.payload = currentUnit + \": \" + minutes + \" min \" + seconds + \" sec\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 380,
