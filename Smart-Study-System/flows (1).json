    {
        "id": "d6930da309a44ce5",
        "type": "function",
        "z": "4c59e0a7bb62b38b",
        "name": "function 8",
        "func": "let unitTimes = flow.get(\"unitTimes\") || {};\n\nlet summary = \"\";\n\nfor (let unit in unitTimes) {\n    if (unit === \"No Unit Selected\") continue;\n\n    let totalSeconds = unitTimes[unit];\n    let minutes = Math.floor(totalSeconds / 60);\n    let seconds = totalSeconds % 60;\n\n    summary += unit + \": \" + minutes + \" min \" + seconds + \" sec\\n\";\n}\n\nmsg.payload = summary || \"No units studied yet\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 80,
